#!/usr/bin/env bash
set -Eeuo pipefail

PROFILE_DIR="/usr/share/iulinux/profiles"
STATE_DIR="/var/lib/iulinux/profiles"

fail()
{
    echo "[FAIL] $*" >&2
    exit 1
}

id="${1:-}"

[[ "${EUID}" -eq 0 ]] ||
    fail "Profile removal requires root."

[[ "${id}" =~ ^[a-z0-9][a-z0-9._-]*$ ]] ||
    fail "Invalid profile ID."

profile="${PROFILE_DIR}/${id}"
state="${STATE_DIR}/${id}"

[[ -f "${profile}/profile.conf" ]] ||
    fail "Unknown profile: ${id}"

[[ -f "${state}/installed" ]] ||
    fail "Profile is not installed: ${id}"

# Load profile metadata.
# shellcheck disable=SC1090
source "${profile}/profile.conf"

owned="${state}/packages-owned-explicit"

[[ -f "${owned}" ]] ||
    fail "Explicit package provenance missing."

basepkg()
{
    printf '%s\n' "${1%%:*}"
}

mapfile -t owned_packages < "${owned}"
installed_owned=()

for pkg in "${owned_packages[@]}"; do
    [[ -n "${pkg}" ]] || continue

    status="$(
        dpkg-query -W -f='${db:Status-Abbrev}' "${pkg}" \
            2>/dev/null || true
    )"

    if [[ "${status}" == "ii " ]]; then
        installed_owned+=("${pkg}")
    fi
done

echo "============================================"
echo " IULinux profile removal plan: ${PROFILE_NAME}"
echo "============================================"
echo
echo "Explicit packages owned:     ${#owned_packages[@]}"
echo "Currently installed owned:   ${#installed_owned[@]}"

if (( ${#installed_owned[@]} )); then
    simulation="$(
        LC_ALL=C apt-get -s remove --no-auto-remove \
            "${installed_owned[@]}"
    )"

    while IFS= read -r planned; do
        [[ -n "${planned}" ]] || continue

        planned_base="$(basepkg "${planned}")"
        allowed=0

        for owned_pkg in "${owned_packages[@]}"; do
            if [[ "${planned_base}" == "$(basepkg "${owned_pkg}")" ]]; then
                allowed=1
                break
            fi
        done

        (( allowed == 1 )) ||
            fail "APT would remove non-profile package: ${planned}"
    done < <(
        awk '/^Remv / {print $2}' <<<"${simulation}"
    )
fi

echo "[PASS] Explicit package removal safety simulation"

hash_path()
{
    local path="$1"

    if [[ -L "${path}" ]]; then
        printf 'symlink:%s' "$(readlink -- "${path}")" |
            sha256sum |
            awk '{print $1}'
    elif [[ -f "${path}" ]]; then
        sha256sum "${path}" |
            awk '{print $1}'
    else
        return 1
    fi
}

hashes="${state}/overlay-sha256"

[[ -f "${hashes}" ]] ||
    fail "Overlay checksum provenance missing."

unchanged_files=0
modified_files=0
missing_files=0

while IFS=$'\t' read -r expected rel; do
    [[ -n "${rel}" ]] || continue

    [[ "${rel}" != /* ]] ||
        fail "Unsafe absolute overlay path: ${rel}"

    target="/${rel}"

    if [[ ! -e "${target}" && ! -L "${target}" ]]; then
        missing_files=$((missing_files + 1))
        continue
    fi

    current="$(hash_path "${target}")" ||
        fail "Unable to hash profile file: ${target}"

    if [[ "${current}" == "${expected}" ]]; then
        unchanged_files=$((unchanged_files + 1))
    else
        echo "[WARN] Modified profile file would be preserved: ${target}"
        modified_files=$((modified_files + 1))
    fi
done < "${hashes}"

echo
echo "Overlay files unchanged:     ${unchanged_files}"
echo "Overlay files modified:      ${modified_files}"
echo "Overlay files already absent:${missing_files}"
echo "[PASS] Overlay removal safety simulation"

# Apply profile-specific shutdown policy before package removal.
if [[ -x "${profile}/pre-remove" ]]; then
    echo
    echo "[IULinux] Applying profile removal policy..."
    "${profile}/pre-remove"
fi

# Remove only explicit packages that this profile owns.
# Dependencies are deliberately left alone for now.
if (( ${#installed_owned[@]} )); then
    echo
    echo "[IULinux] Removing profile-owned explicit packages..."

    LC_ALL=C apt-get remove -y --no-auto-remove \
        "${installed_owned[@]}"
else
    echo "[INFO] No profile-owned explicit packages remain installed."
fi

echo "[PASS] Explicit profile packages removed safely"
echo "[INFO] Dependency autoremove intentionally disabled"

# Remove profile overlay files only if they are byte-for-byte unchanged.
removed_overlay=0
preserved_overlay=0

echo
echo "[IULinux] Removing unchanged profile files..."

while IFS=$'\t' read -r expected rel; do
    [[ -n "${rel}" ]] || continue

    [[ "${rel}" != /* &&
       "${rel}" != ".." &&
       "${rel}" != ../* &&
       "${rel}" != */../* ]] ||
        fail "Unsafe overlay path: ${rel}"

    target="/${rel}"

    if [[ ! -e "${target}" && ! -L "${target}" ]]; then
        echo "[INFO] Already absent: ${target}"
        continue
    fi

    current="$(hash_path "${target}")" || {
        echo "[WARN] Unable to hash; preserving: ${target}"
        preserved_overlay=$((preserved_overlay + 1))
        continue
    }

    if [[ "${current}" == "${expected}" ]]; then
        rm -f -- "${target}"
        echo "[PASS] Removed unchanged profile file: ${target}"
        removed_overlay=$((removed_overlay + 1))
    else
        echo "[WARN] Modified profile file preserved: ${target}"
        preserved_overlay=$((preserved_overlay + 1))
    fi
done < "${hashes}"

echo
echo "Overlay files removed:    ${removed_overlay}"
echo "Modified files preserved: ${preserved_overlay}"
echo "[PASS] Profile overlay cleanup completed safely"
