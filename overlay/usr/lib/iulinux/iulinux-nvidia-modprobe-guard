#!/bin/sh
set -eu

MARKER="/etc/iulinux/nvidia-autoload-blocked"

if [ "$#" -lt 1 ]; then
    echo "IULinux NVIDIA guard: missing module name" >&2
    exit 64
fi

module="$1"
shift

case "$module" in
    nvidia|nvidia_drm|nvidia_modeset|nvidia_uvm)
        ;;
    *)
        echo "IULinux NVIDIA guard: unsupported module: $module" >&2
        exit 64
        ;;
esac

if [ -e "$MARKER" ]; then
    echo \
      "IULinux: refusing $module autoload while Integrated graphics mode is active" \
      >&2
    exit 1
fi

exec /sbin/modprobe \
    --ignore-install \
    "$module" \
    "$@"
