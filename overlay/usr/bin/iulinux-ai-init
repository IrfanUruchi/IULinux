#!/usr/bin/env bash
set -Eeuo pipefail

AI_ROOT="${HOME}/AI"

mkdir -p \
    "${AI_ROOT}/models" \
    "${AI_ROOT}/projects" \
    "${AI_ROOT}/venvs" \
    "${HOME}/.cache/iulinux-ai"

cat <<INFO
============================================
 IULinux AI workspace initialized
============================================

Projects: ${AI_ROOT}/projects
Models:   ${AI_ROOT}/models
Venvs:    ${AI_ROOT}/venvs
Cache:    ${HOME}/.cache/iulinux-ai

Recommended Python workflow:

  python3 -m venv ~/AI/venvs/my-project
  source ~/AI/venvs/my-project/bin/activate
  python -m pip install --upgrade pip

For standalone Python CLI tools:

  pipx install <package>

INFO
