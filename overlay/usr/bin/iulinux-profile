#!/usr/bin/env bash
set -Eeuo pipefail

PROFILE_DIR="/usr/share/iulinux/profiles"
STATE_DIR="/var/lib/iulinux/profiles"

usage()
{
    cat <<'USAGE'
Usage:
  iulinux-profile list
  iulinux-profile info <profile>
  iulinux-profile plan <profile>
  iulinux-profile status <profile>
  sudo iulinux-profile install <profile>
USAGE
}

load_profile()
{
    local id="${1:-}"

    [[ -n "${id}" ]] || {
        echo "[FAIL] Profile name required." >&2
        exit 2
    }

    PROFILE_PATH="${PROFILE_DIR}/${id}"
    PROFILE_MANIFEST="${PROFILE_PATH}/profile.conf"

    [[ -f "${PROFILE_MANIFEST}" ]] || {
        echo "[FAIL] Unknown IULinux profile: ${id}" >&2
        exit 3
    }

    unset \
        PROFILE_ID \
        PROFILE_NAME \
        PROFILE_DESCRIPTION \
        PROFILE_DEFAULT \
        PROFILE_TIER

    # shellcheck disable=SC1090
    source "${PROFILE_MANIFEST}"
}

read_packages()
{
    local file="${PROFILE_PATH}/packages.list"

    [[ -f "${file}" ]] || return 0

    sed \
        -e 's/#.*$//' \
        -e '/^[[:space:]]*$/d' \
        "${file}"
}

profile_state_path()
{
    echo "${STATE_DIR}/${PROFILE_ID}"
}

profile_installed()
{
    [[ -f "$(profile_state_path)/installed" ||
       -f "${STATE_DIR}/${PROFILE_ID}.installed" ]]
}

package_is_installed()
{
    dpkg-query -W -f='${db:Status-Abbrev}' "$1" \
        2>/dev/null |
        grep -q '^ii '
}

snapshot_packages()
{
    LC_ALL=C dpkg-query -W \
        -f='${binary:Package} ${db:Status-Abbrev}\n' \
        2>/dev/null |
        awk '$2 == "ii" {print $1}' |
        LC_ALL=C sort -u
}

overlay_file_list()
{
    local overlay="${PROFILE_PATH}/overlay"

    [[ -d "${overlay}" ]] || return 0

    find "${overlay}" \
        \( -type f -o -type l \) \
        -printf '%P\n' |
        sort
}

check_overlay_collisions()
{
    local rel target
    local collision=0

    while IFS= read -r rel; do
        [[ -n "${rel}" ]] || continue
        target="/${rel}"

        if [[ -e "${target}" || -L "${target}" ]]; then
            echo "[FAIL] Profile overlay collision: ${target}" >&2
            collision=1
        fi
    done < <(overlay_file_list)

    (( collision == 0 ))
}

list_profiles()
{
    printf "%-14s %-10s %-11s %s\n" \
        "PROFILE" "TIER" "STATUS" "DESCRIPTION"

    printf "%-14s %-10s %-11s %s\n" \
        "-------" "----" "------" "-----------"

    for manifest in "${PROFILE_DIR}"/*/profile.conf; do
        [[ -f "${manifest}" ]] || continue

        unset \
            PROFILE_ID \
            PROFILE_NAME \
            PROFILE_DESCRIPTION \
            PROFILE_TIER

        # shellcheck disable=SC1090
        source "${manifest}"

        if profile_installed; then
            state="installed"
        else
            state="available"
        fi

        printf "%-14s %-10s %-11s %s\n" \
            "${PROFILE_ID}" \
            "${PROFILE_TIER}" \
            "${state}" \
            "${PROFILE_DESCRIPTION}"
    done
}

show_info()
{
    load_profile "$1"

    echo "============================================"
    echo " IULinux profile: ${PROFILE_NAME}"
    echo "============================================"
    echo
    echo "ID:          ${PROFILE_ID}"
    echo "Tier:        ${PROFILE_TIER}"
    echo "Default:     ${PROFILE_DEFAULT}"
    echo "Description: ${PROFILE_DESCRIPTION}"
}

show_plan()
{
    load_profile "$1"

    echo "============================================"
    echo " IULinux profile plan: ${PROFILE_NAME}"
    echo "============================================"
    echo
    echo "The following explicit packages would be installed:"
    echo

    read_packages | sed 's/^/  /'

    echo
    echo "Profile overlay:"
    echo "  ${PROFILE_PATH}/overlay"
    echo
    echo "Nothing has been changed."
}

show_status()
{
    load_profile "$1"

    if profile_installed; then
        echo "${PROFILE_ID}: installed"

        state="$(profile_state_path)"

        if [[ -f "${state}/packages-added" ]]; then
            echo "Packages added: $(wc -l < "${state}/packages-added")"
        fi

        if [[ -f "${state}/overlay-files" ]]; then
            echo "Overlay files:  $(wc -l < "${state}/overlay-files")"
        fi

        exit 0
    fi

    echo "${PROFILE_ID}: not installed"
}

install_profile()
{
    load_profile "$1"

    [[ "${EUID}" -eq 0 ]] || {
        echo "[FAIL] Profile installation requires root." >&2
        echo "Run:" >&2
        echo "  sudo iulinux-profile install ${PROFILE_ID}" >&2
        exit 4
    }

    install -d -m 0755 "${STATE_DIR}"

    if profile_installed; then
        echo "[INFO] Profile already installed: ${PROFILE_ID}"
        exit 0
    fi

    mapfile -t packages < <(read_packages)

    echo "============================================"
    echo " Installing IULinux profile: ${PROFILE_NAME}"
    echo "============================================"

    # Refuse to overwrite anything already owned by the base system/user.
    check_overlay_collisions || {
        echo "[FAIL] Profile installation aborted before package changes." >&2
        exit 5
    }

    tmp_state="$(
        mktemp -d "${STATE_DIR}/.${PROFILE_ID}.install.XXXXXX"
    )"

    cleanup()
    {
        rm -rf "${tmp_state}" 2>/dev/null || true
    }
    trap cleanup EXIT

    printf '%s\n' "${packages[@]}" \
        > "${tmp_state}/packages-requested"

    snapshot_packages \
        > "${tmp_state}/packages-before"

    : > "${tmp_state}/packages-preexisting"

    for pkg in "${packages[@]}"; do
        if package_is_installed "${pkg}"; then
            echo "${pkg}" >> "${tmp_state}/packages-preexisting"
        fi
    done

    if (( ${#packages[@]} )); then
        apt-get update

        apt-get install -y --no-install-recommends \
            "${packages[@]}"
    fi

    snapshot_packages \
        > "${tmp_state}/packages-after"

    LC_ALL=C comm -13 \
        "${tmp_state}/packages-before" \
        "${tmp_state}/packages-after" \
        > "${tmp_state}/packages-added"

    # Packages may theoretically introduce a path used by a profile overlay.
    # Refuse to overwrite it rather than silently replacing package/user data.
    check_overlay_collisions || {
        echo "[FAIL] Overlay collision detected after package installation." >&2
        echo "[FAIL] Installation state retained for inspection:" >&2
        echo "       ${tmp_state}" >&2
        trap - EXIT
        exit 6
    }

    overlay_file_list \
        > "${tmp_state}/overlay-files"

    if [[ -d "${PROFILE_PATH}/overlay" ]]; then
        echo
        echo "[IULinux] Applying profile overlay..."
        cp -a "${PROFILE_PATH}/overlay/." /
    fi

    if [[ -x "${PROFILE_PATH}/post-install" ]]; then
        echo
        echo "[IULinux] Applying profile policy..."
        "${PROFILE_PATH}/post-install"
    fi

    {
        echo "PROFILE_ID=${PROFILE_ID}"
        echo "PROFILE_NAME=${PROFILE_NAME}"
        echo "INSTALLED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    } > "${tmp_state}/metadata"

    touch "${tmp_state}/installed"

    final_state="$(profile_state_path)"
    mv "${tmp_state}" "${final_state}"

    # Profile state is system metadata, not secret data.
    # Normal users must be able to inspect profile installation status.
    chmod 0755 "${final_state}"
    find "${final_state}" -maxdepth 1 -type f -exec chmod 0644 {} +

    trap - EXIT

    echo
    echo "Packages requested:     ${#packages[@]}"
    echo "Packages pre-existing:  $(
        wc -l < "${final_state}/packages-preexisting"
    )"
    echo "Packages newly added:   $(
        wc -l < "${final_state}/packages-added"
    )"
    echo "Overlay files recorded: $(
        wc -l < "${final_state}/overlay-files"
    )"

    echo
    echo "============================================"
    echo " Profile installed: ${PROFILE_NAME}"
    echo "============================================"
}

case "${1:-}" in
    list)
        list_profiles
        ;;

    info)
        show_info "${2:-}"
        ;;

    plan)
        show_plan "${2:-}"
        ;;

    status)
        show_status "${2:-}"
        ;;

    install)
        install_profile "${2:-}"
        ;;

    *)
        usage
        exit 2
        ;;
esac
