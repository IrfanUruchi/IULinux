#!/usr/bin/env bash
set -Eeuo pipefail

MODE="${1:---check}"
CUDA_SERIES="13-3"
CUDA_REPO="ubuntu2604"
CUDA_ARCH="x86_64"
CUDA_BASE="https://developer.download.nvidia.com/compute/cuda/repos/${CUDA_REPO}/${CUDA_ARCH}"

has_nvidia_gpu()
{
    lspci -Dn 2>/dev/null |
        awk '
            $2 ~ /^(0300|0302|0380):/ &&
            $3 ~ /^10de:/ {
                found=1
            }
            END { exit !found }
        '
}

case "${MODE}" in
    --check)
        echo "============================================"
        echo " IULinux CUDA development check"
        echo "============================================"

        if ! has_nvidia_gpu; then
            echo "[INFO] No NVIDIA GPU detected."
            echo "[INFO] Host CUDA toolkit is not required."
            exit 0
        fi

        echo "[PASS] NVIDIA GPU detected"

        command -v nvidia-smi >/dev/null 2>&1 \
            && echo "[PASS] NVIDIA driver available" \
            || echo "[INFO] NVIDIA driver not installed/loaded"

        if command -v nvcc >/dev/null 2>&1; then
            echo "[PASS] CUDA compiler available"
            nvcc --version | tail -1
        else
            echo "[INFO] CUDA toolkit not installed."
            echo "Run:"
            echo "  sudo iulinux-cuda-setup --install"
        fi
        ;;

    --install)
        [[ "${EUID}" -eq 0 ]] || {
            echo "[FAIL] Run as root:" >&2
            echo "  sudo iulinux-cuda-setup --install" >&2
            exit 2
        }

        has_nvidia_gpu || {
            echo "[FAIL] No NVIDIA GPU detected." >&2
            echo "[FAIL] Refusing host CUDA installation." >&2
            exit 3
        }

        command -v nvidia-smi >/dev/null 2>&1 || {
            echo "[FAIL] NVIDIA driver unavailable." >&2
            echo "Run first:" >&2
            echo "  sudo iulinux-nvidia-setup --install" >&2
            echo "Then reboot." >&2
            exit 4
        }

        echo "============================================"
        echo " IULinux CUDA ${CUDA_SERIES} setup"
        echo "============================================"

        TMP="$(mktemp --suffix=.deb)"
        trap 'rm -f "${TMP}"' EXIT

        curl -fsSL \
            "${CUDA_BASE}/cuda-keyring_1.1-1_all.deb" \
            -o "${TMP}"

        dpkg -i "${TMP}"
        apt-get update

        echo
        echo "[IULinux] Installing CUDA Toolkit ${CUDA_SERIES}..."
        apt-get install -y "cuda-toolkit-${CUDA_SERIES}"

        echo
        echo "=== CUDA TOOLKIT ==="

        if [[ -x "/usr/local/cuda-${CUDA_SERIES/-/.}/bin/nvcc" ]]; then
            "/usr/local/cuda-${CUDA_SERIES/-/.}/bin/nvcc" --version
        elif command -v nvcc >/dev/null 2>&1; then
            nvcc --version
        fi

        echo
        echo "============================================"
        echo " CUDA DEVELOPMENT TOOLKIT COMPLETE"
        echo "============================================"
        ;;

    *)
        echo "Usage:"
        echo "  iulinux-cuda-setup --check"
        echo "  sudo iulinux-cuda-setup --install"
        exit 2
        ;;
esac
