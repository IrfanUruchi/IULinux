#!/usr/bin/python3

import os
import subprocess
import sys
import time
from pathlib import Path


ASUS_ROOT = Path(
    "/sys/class/firmware-attributes/asus-armoury/attributes"
)

PENDING_MODE = Path(
    "/var/lib/iulinux/graphics-pending-mode"
)


def fail(message):
    print(message, file=sys.stderr)
    raise SystemExit(1)


def read(path):
    return Path(path).read_text().strip()


def validate_enum(attribute):
    path = ASUS_ROOT / attribute

    if not path.is_dir():
        fail(f"Unsupported hardware: missing {attribute}")

    possible = {
        value.strip()
        for value in read(path / "possible_values").split(";")
        if value.strip()
    }

    if possible != {"0", "1"}:
        fail(
            f"Unsupported {attribute} values: "
            + ",".join(sorted(possible))
        )

    return path


def firmware_pending_reboot():
    path = ASUS_ROOT / "pending_reboot"

    if not path.is_file():
        return False

    try:
        return read(path) == "1"
    except Exception:
        return False


def system_is_stopping():
    try:
        result = subprocess.run(
            [
                "/usr/bin/systemctl",
                "is-system-running",
            ],
            capture_output=True,
            text=True,
            timeout=2.0,
            check=False,
        )
    except Exception:
        return False

    return result.stdout.strip() == "stopping"


def pending_target():
    if not PENDING_MODE.is_file():
        return None

    try:
        value = read(PENDING_MODE)
    except Exception:
        return None

    if value in {"Integrated", "Hybrid", "Discrete"}:
        return value

    fail("Invalid pending graphics mode")


def clear_pending():
    PENDING_MODE.unlink(missing_ok=True)


def configured_state():
    dgpu = read(
        validate_enum("dgpu_disable") / "current_value"
    )

    mux = read(
        validate_enum("gpu_mux_mode") / "current_value"
    )

    if dgpu == "1":
        return "Integrated", dgpu, mux

    if dgpu == "0" and mux == "1":
        return "Hybrid", dgpu, mux

    if dgpu == "0" and mux == "0":
        return "Discrete", dgpu, mux

    fail("Firmware reports an unsupported graphics state")


def write_attribute(attribute, value, allow_deferred=False):
    path = validate_enum(attribute)
    current = path / "current_value"

    try:
        current.write_text(value)
    except Exception as exc:
        fail(f"Unable to change {attribute}: {exc}")

    actual = read(current)

    if actual == value:
        return

    if allow_deferred and firmware_pending_reboot():
        return

    fail(
        f"{attribute} verification failed: "
        f"requested {value}, read back {actual}"
    )


def process_uses_nvidia(proc):
    try:
        for fd in (proc / "fd").iterdir():
            try:
                target = os.readlink(fd)

                if target.startswith("/dev/nvidia"):
                    return True

            except Exception:
                continue
    except Exception:
        pass

    try:
        maps = (proc / "maps").read_text(
            errors="replace"
        )

        if "/dev/nvidia" in maps:
            return True

    except Exception:
        pass

    return False


def nvidia_clients():
    clients = []

    for proc in Path("/proc").glob("[0-9]*"):
        if not process_uses_nvidia(proc):
            continue

        try:
            name = read(proc / "comm")
        except Exception:
            name = "unknown"

        clients.append(f"{proc.name}:{name}")

    return clients


def wait_for_no_nvidia_clients(timeout=8.0):
    deadline = time.monotonic() + timeout

    while time.monotonic() < deadline:
        clients = nvidia_clients()

        if not clients:
            return

        time.sleep(0.2)

    clients = nvidia_clients()

    if clients:
        fail(
            "Refusing graphics firmware transition while "
            "NVIDIA is still in use by: "
            + ", ".join(clients[:12])
        )


def apply(target):
    configured, dgpu, mux = configured_state()

    if target == configured and not firmware_pending_reboot():
        clear_pending()
        print(
            f"{target} graphics mode was already configured"
        )
        return

    if target == "Integrated":
        if configured == "Discrete" or mux == "0":
            fail(
                "Integrated requires Hybrid mode first"
            )

        wait_for_no_nvidia_clients()
        write_attribute("dgpu_disable", "1")

        clear_pending()
        print(
            "Applied pending Integrated graphics mode "
            "during shutdown"
        )
        return

    if target == "Hybrid":
        if configured == "Integrated":
            # Enabling the dGPU after the graphical stack has stopped
            # is safe; the next boot performs normal driver discovery.
            write_attribute("dgpu_disable", "0")

        elif configured == "Discrete":
            wait_for_no_nvidia_clients()

            write_attribute(
                "gpu_mux_mode",
                "1",
                allow_deferred=True,
            )

        clear_pending()
        print(
            "Applied pending Hybrid graphics mode "
            "during shutdown"
        )
        return

    if target == "Discrete":
        if configured == "Integrated":
            fail(
                "Discrete requires Hybrid mode first"
            )

        if configured == "Hybrid":
            wait_for_no_nvidia_clients()

            write_attribute(
                "gpu_mux_mode",
                "0",
                allow_deferred=True,
            )

        clear_pending()
        print(
            "Applied pending Discrete graphics mode "
            "during shutdown"
        )
        return

    fail("Unsupported pending graphics mode")


def main():
    if os.geteuid() != 0:
        fail("Graphics shutdown helper requires root")

    target = pending_target()

    if target is None:
        return

    # ExecStop can also run if somebody stops/restarts the unit
    # manually. Never mutate graphics firmware unless systemd is
    # actually shutting the machine down.
    if not system_is_stopping():
        print(
            "Pending graphics transition retained; "
            "system is not shutting down"
        )
        return

    apply(target)


if __name__ == "__main__":
    main()
