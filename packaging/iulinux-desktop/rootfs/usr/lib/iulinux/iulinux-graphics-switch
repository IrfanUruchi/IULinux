#!/usr/bin/python3

import os
import subprocess
import sys
from pathlib import Path


ASUS_ROOT = Path(
    "/sys/class/firmware-attributes/asus-armoury/attributes"
)

PENDING_MODE = Path(
    "/var/lib/iulinux/graphics-pending-mode"
)

TRANSITION_SERVICE = "iulinux-graphics-transition.service"


def fail(message, code=1):
    print(message, file=sys.stderr)
    raise SystemExit(code)


def read(path):
    try:
        return path.read_text().strip()
    except Exception as exc:
        fail(f"Unable to read {path}: {exc}")


def validate_enum(attribute):
    path = ASUS_ROOT / attribute

    if not path.is_dir():
        fail(f"Unsupported hardware: missing {attribute}")

    possible = {
        value.strip()
        for value in read(path / "possible_values").split(";")
        if value.strip()
    }

    if possible != {"0", "1"}:
        fail(
            f"Unsupported {attribute} values: "
            + ",".join(sorted(possible))
        )

    return path


def firmware_pending_reboot():
    path = ASUS_ROOT / "pending_reboot"

    if not path.is_file():
        return False

    try:
        return path.read_text().strip() == "1"
    except Exception:
        return False


def configured_state():
    dgpu = read(
        validate_enum("dgpu_disable") / "current_value"
    )

    mux = read(
        validate_enum("gpu_mux_mode") / "current_value"
    )

    if dgpu == "1":
        return "Integrated", dgpu, mux

    if dgpu == "0" and mux == "1":
        return "Hybrid", dgpu, mux

    if dgpu == "0" and mux == "0":
        return "Discrete", dgpu, mux

    fail("Firmware reports an unsupported graphics state")


def set_pending(target):
    PENDING_MODE.parent.mkdir(
        parents=True,
        exist_ok=True,
        mode=0o755,
    )

    PENDING_MODE.write_text(target + "\n")
    os.chmod(PENDING_MODE, 0o644)


def clear_pending():
    try:
        PENDING_MODE.unlink()
    except FileNotFoundError:
        pass


def pending_target():
    try:
        value = PENDING_MODE.read_text().strip()
    except Exception:
        return None

    if value in {"Integrated", "Hybrid", "Discrete"}:
        return value

    return None


def ensure_transition_service():
    try:
        result = subprocess.run(
            [
                "/usr/bin/systemctl",
                "start",
                TRANSITION_SERVICE,
            ],
            capture_output=True,
            text=True,
            timeout=8.0,
            check=False,
        )
    except Exception as exc:
        fail(
            "Unable to arm the graphics shutdown transition: "
            + str(exc)
        )

    if result.returncode != 0:
        message = result.stderr.strip() or result.stdout.strip()

        fail(
            message
            or "Unable to arm the graphics shutdown transition"
        )


def switch(target):
    configured, dgpu, mux = configured_state()
    pending = pending_target()

    # Selecting the already configured mode cancels an uncommitted
    # IULinux request. No firmware mutation occurs in the live session.
    if target == configured and not firmware_pending_reboot():
        if pending is not None:
            clear_pending()
            print(
                f"Pending graphics transition cancelled. "
                f"Already configured for {target} mode."
            )
        else:
            print(f"Already in {target} mode")

        return

    if pending == target:
        ensure_transition_service()

        print(
            f"{target} mode is already scheduled. "
            "Restart required to complete the transition."
        )
        return

    # Keep Integrated <-> Discrete transitions deliberately two-step.
    # This avoids enabling/disabling the dGPU and changing the display
    # MUX in one shutdown transaction.
    if (
        configured == "Integrated"
        and target == "Discrete"
    ):
        fail(
            "Cannot switch directly from Integrated to Discrete. "
            "Select Hybrid, restart, then select Discrete."
        )

    if (
        configured == "Discrete"
        and target == "Integrated"
    ):
        fail(
            "Cannot switch directly from Discrete to Integrated. "
            "Select Hybrid, restart, then select Integrated."
        )

    # The live graphical session only records intent. The ASUS firmware
    # attributes are changed during orderly shutdown, after display and
    # NVIDIA users have been stopped.
    ensure_transition_service()
    set_pending(target)

    print(
        f"{target} mode scheduled. "
        "Restart required to complete the transition."
    )


def main():
    if os.geteuid() != 0:
        fail(
            "This helper must be invoked through Polkit/pkexec",
            77,
        )

    if len(sys.argv) != 2:
        fail(
            "Usage: iulinux-graphics-switch "
            "{Integrated|Hybrid|Discrete}",
            64,
        )

    target = sys.argv[1]

    if target not in {
        "Integrated",
        "Hybrid",
        "Discrete",
    }:
        fail("Unsupported graphics mode", 64)

    switch(target)


if __name__ == "__main__":
    main()
