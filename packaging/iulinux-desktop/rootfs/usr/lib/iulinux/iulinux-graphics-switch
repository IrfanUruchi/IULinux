#!/usr/bin/python3

import os
import sys
import time
from pathlib import Path


ASUS_ROOT = Path(
    "/sys/class/firmware-attributes/asus-armoury/attributes"
)

PENDING_MODE = Path(
    "/var/lib/iulinux/graphics-pending-mode"
)


def fail(message, code=1):
    print(message, file=sys.stderr)
    raise SystemExit(code)


def read(path):
    try:
        return path.read_text().strip()
    except Exception as exc:
        fail(f"Unable to read {path}: {exc}")


def validate_enum(attribute):
    path = ASUS_ROOT / attribute

    if not path.is_dir():
        fail(f"Unsupported hardware: missing {attribute}")

    possible = {
        value.strip()
        for value in read(path / "possible_values").split(";")
        if value.strip()
    }

    if possible != {"0", "1"}:
        fail(
            f"Unsupported {attribute} values: "
            + ",".join(sorted(possible))
        )

    return path


def firmware_pending_reboot():
    path = ASUS_ROOT / "pending_reboot"

    if not path.is_file():
        return False

    try:
        return path.read_text().strip() == "1"
    except Exception:
        return False


def write_attribute(attribute, value, allow_deferred=False):
    path = validate_enum(attribute)
    current = path / "current_value"

    if value not in {"0", "1"}:
        fail("Internal error: invalid firmware value")

    try:
        current.write_text(value)
    except Exception as exc:
        fail(f"Unable to change {attribute}: {exc}")

    actual = read(current)

    if actual == value:
        return True

    if allow_deferred and firmware_pending_reboot():
        return False

    fail(
        f"{attribute} verification failed: "
        f"requested {value}, read back {actual}"
    )


def set_pending(target):
    PENDING_MODE.parent.mkdir(
        parents=True,
        exist_ok=True,
        mode=0o755,
    )

    PENDING_MODE.write_text(target + "\n")
    os.chmod(PENDING_MODE, 0o644)


def clear_pending():
    try:
        PENDING_MODE.unlink()
    except FileNotFoundError:
        pass


def pending_target():
    try:
        value = PENDING_MODE.read_text().strip()
    except Exception:
        return None

    if value in {"Integrated", "Hybrid", "Discrete"}:
        return value

    return None


def nvidia_bound():
    pci_root = Path("/sys/bus/pci/devices")

    try:
        devices = list(pci_root.iterdir())
    except Exception:
        return False

    for device in devices:
        try:
            if (device / "vendor").read_text().strip().lower() != "0x10de":
                continue

            driver = device / "driver"

            if not driver.is_symlink():
                continue

            if Path(os.path.realpath(driver)).name == "nvidia":
                return True

        except Exception:
            continue

    return False


def wait_nvidia_bound(timeout=2.0):
    deadline = time.monotonic() + timeout

    while time.monotonic() < deadline:
        if nvidia_bound():
            return True

        time.sleep(0.1)

    return nvidia_bound()


def state():
    dgpu = read(
        validate_enum("dgpu_disable") / "current_value"
    )

    mux = read(
        validate_enum("gpu_mux_mode") / "current_value"
    )

    if dgpu == "1":
        return "Integrated", dgpu, mux

    if dgpu == "0" and mux == "1":
        return "Hybrid", dgpu, mux

    if dgpu == "0" and mux == "0":
        return "Discrete", dgpu, mux

    fail("Firmware reports an unsupported graphics state")


def switch(target):
    configured, dgpu, mux = state()
    pending = pending_target()

    if target == configured:
        if pending == target:
            print(
                f"{target} mode is configured. "
                "Restart required to complete the transition."
            )
            return

        if target == "Hybrid" and not nvidia_bound():
            set_pending("Hybrid")
            print(
                "Hybrid mode is configured, but the NVIDIA GPU "
                "is not attached to the running kernel. "
                "Restart required."
            )
            return

        clear_pending()
        print(f"Already in {target} mode")
        return

    if target == "Hybrid":
        # Moving away from Discrete requires a MUX change, which is
        # intentionally treated as a reboot transition.
        if mux == "0":
            set_pending("Hybrid")

            write_attribute(
                "gpu_mux_mode",
                "1",
                allow_deferred=True,
            )

            print(
                "Hybrid mode selected. Restart required "
                "to complete the display MUX transition."
            )
            return

        # Integrated -> Hybrid can be attempted live. Do not force
        # driver rebinding from a running graphical session; if normal
        # hotplug does not restore NVIDIA, keep the request pending.
        if dgpu == "1":
            write_attribute("dgpu_disable", "0")

            if wait_nvidia_bound():
                clear_pending()
                print("Hybrid mode enabled")
                return

            set_pending("Hybrid")

            print(
                "Hybrid mode configured. Restart required "
                "to attach the NVIDIA GPU cleanly."
            )
            return

        set_pending("Hybrid")
        print(
            "Hybrid mode configured. Restart required "
            "to attach the NVIDIA GPU cleanly."
        )
        return

    if target == "Integrated":
        if mux == "0":
            fail(
                "Cannot switch directly from Discrete to "
                "Integrated. Select Hybrid first and restart."
            )

        # Never remove an NVIDIA GPU from a running graphical session
        # while the kernel driver is attached. We proved on real ASUS
        # hardware that doing so can leave stale NVIDIA users and make
        # the next bind block in uninterruptible kernel sleep.
        if nvidia_bound():
            set_pending("Integrated")

            print(
                "Integrated mode scheduled. Restart required "
                "so NVIDIA can be disabled before the graphical "
                "session starts."
            )
            return

        write_attribute("dgpu_disable", "1")
        clear_pending()
        print("Integrated mode enabled")
        return

    if target == "Discrete":
        # The ASUS interface requires the dGPU enabled before asking
        # firmware to route the display MUX to it.
        if dgpu == "1":
            write_attribute("dgpu_disable", "0")

        set_pending("Discrete")

        write_attribute(
            "gpu_mux_mode",
            "0",
            allow_deferred=True,
        )

        print(
            "Discrete mode selected. Restart required "
            "to complete the display MUX transition."
        )
        return

    fail("Unsupported graphics mode")


def main():
    if os.geteuid() != 0:
        fail(
            "This helper must be invoked through Polkit/pkexec",
            77,
        )

    if len(sys.argv) != 2:
        fail(
            "Usage: iulinux-graphics-switch "
            "{Integrated|Hybrid|Discrete}",
            64,
        )

    switch(sys.argv[1])


if __name__ == "__main__":
    main()
