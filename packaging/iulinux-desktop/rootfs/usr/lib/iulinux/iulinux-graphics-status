#!/usr/bin/python3

import json
import os
from pathlib import Path

try:
    import dbus
except Exception:
    dbus = None


VENDORS = {
    "0x8086": "Intel",
    "0x1002": "AMD",
    "0x10de": "NVIDIA",
    "0x1af4": "VirtIO",
}

PENDING_MODE = Path(
    "/var/lib/iulinux/graphics-pending-mode"
)


def plain(value):
    if isinstance(value, dict):
        return {str(k): plain(v) for k, v in value.items()}

    if isinstance(value, (list, tuple)):
        return [plain(v) for v in value]

    if isinstance(value, bool):
        return value

    try:
        if dbus is not None and isinstance(
            value,
            (
                dbus.Boolean,
                dbus.Byte,
                dbus.Int16,
                dbus.UInt16,
                dbus.Int32,
                dbus.UInt32,
                dbus.Int64,
                dbus.UInt64,
            ),
        ):
            return int(value)
    except Exception:
        pass

    return str(value)


def read_text(path):
    try:
        return Path(path).read_text().strip()
    except Exception:
        return ""


def drm_devices():
    devices = []
    seen = set()

    for card in sorted(Path("/sys/class/drm").glob("card*")):
        if not card.name.startswith("card") or not card.name[4:].isdigit():
            continue

        dev = card / "device"

        if not dev.exists():
            continue

        real = os.path.realpath(dev)

        if real in seen:
            continue

        seen.add(real)

        vendor_id = read_text(dev / "vendor").lower()
        device_id = read_text(dev / "device").lower()

        driver = ""
        driver_link = dev / "driver"

        if driver_link.exists():
            try:
                driver = Path(os.path.realpath(driver_link)).name
            except Exception:
                pass

        pci_address = Path(real).name
        boot_vga = read_text(dev / "boot_vga") == "1"

        devices.append(
            {
                "card": card.name,
                "pci_address": pci_address,
                "vendor": VENDORS.get(vendor_id, "Unknown"),
                "vendor_id": vendor_id,
                "device_id": device_id,
                "driver": driver,
                "boot_vga": boot_vga,
            }
        )

    return devices


def switcheroo_state():
    result = {
        "available": False,
        "dual_gpu": False,
        "gpus": [],
    }

    if dbus is None:
        return result

    try:
        bus = dbus.SystemBus()

        obj = bus.get_object(
            "net.hadess.SwitcherooControl",
            "/net/hadess/SwitcherooControl",
        )

        props = dbus.Interface(
            obj,
            "org.freedesktop.DBus.Properties",
        )

        interface = "net.hadess.SwitcherooControl"

        result["available"] = True
        result["dual_gpu"] = bool(
            props.Get(interface, "HasDualGpu")
        )

        raw_gpus = props.Get(interface, "GPUs")

        for index, raw in enumerate(raw_gpus):
            gpu = plain(raw)

            result["gpus"].append(
                {
                    "index": index,
                    "name": str(gpu.get("Name", "GPU")),
                    "default": bool(gpu.get("Default", False)),
                    "environment": gpu.get("Environment", []),
                }
            )

    except Exception:
        pass

    return result



def asus_armoury_state():
    root = Path(
        "/sys/class/firmware-attributes/asus-armoury/attributes"
    )

    result = {
        "available": False,
        "configured_mode": None,
        "supported_modes": [],
        "pending_reboot": False,
    }

    dgpu = root / "dgpu_disable"
    mux = root / "gpu_mux_mode"

    if not dgpu.is_dir() or not mux.is_dir():
        return result

    dgpu_current = read_text(dgpu / "current_value")
    mux_current = read_text(mux / "current_value")

    dgpu_possible = {
        value.strip()
        for value in read_text(
            dgpu / "possible_values"
        ).split(";")
        if value.strip()
    }

    mux_possible = {
        value.strip()
        for value in read_text(
            mux / "possible_values"
        ).split(";")
        if value.strip()
    }

    # Fail closed unless this machine exposes the exact
    # ASUS Armoury interface we have validated.
    if dgpu_possible != {"0", "1"}:
        return result

    if mux_possible != {"0", "1"}:
        return result

    result["available"] = True
    result["supported_modes"] = [
        "Integrated",
        "Hybrid",
        "Discrete",
    ]

    if dgpu_current == "1":
        result["configured_mode"] = "Integrated"

    elif dgpu_current == "0" and mux_current == "1":
        result["configured_mode"] = "Hybrid"

    elif dgpu_current == "0" and mux_current == "0":
        result["configured_mode"] = "Discrete"

    pending = root / "pending_reboot"

    if pending.is_file():
        result["pending_reboot"] = (
            read_text(pending) == "1"
        )

    return result

drm = drm_devices()
switcheroo = switcheroo_state()
asus = asus_armoury_state()

offload_available = False

for gpu in switcheroo["gpus"]:
    if not gpu["default"] and gpu["environment"]:
        offload_available = True
        break


configured_mode = (
    asus.get("configured_mode")
    if asus["available"]
    else None
)

requested_mode = read_text(PENDING_MODE)

if requested_mode not in {
    "Integrated",
    "Hybrid",
    "Discrete",
}:
    requested_mode = None


has_intel = any(
    device.get("vendor_id") == "0x8086"
    for device in drm
)

has_nvidia = any(
    device.get("vendor_id") == "0x10de"
    and device.get("driver") == "nvidia"
    for device in drm
)

default_nvidia = any(
    bool(gpu.get("default"))
    and "nvidia" in str(gpu.get("name", "")).lower()
    for gpu in switcheroo["gpus"]
)


# Top-level current_mode is runtime truth, not merely what ASUS
# firmware attributes were last configured to request.
if asus["available"]:
    if has_intel and not has_nvidia:
        current_mode = "Integrated"

    elif has_nvidia and not has_intel:
        current_mode = "Discrete"

    elif has_intel and has_nvidia:
        if default_nvidia:
            current_mode = "Discrete"

        elif switcheroo["dual_gpu"] and offload_available:
            current_mode = "Hybrid"

        else:
            current_mode = "Unknown"

    else:
        current_mode = "Unknown"

elif switcheroo["dual_gpu"]:
    current_mode = "Hybrid"

elif len(drm) == 1:
    current_mode = "Single GPU"

else:
    current_mode = "Unknown"


transition_pending = bool(
    asus["available"]
    and (
        asus["pending_reboot"]
        or (
            requested_mode
            and requested_mode != current_mode
        )
        or (
            configured_mode
            and configured_mode != current_mode
        )
    )
)

reboot_required = bool(
    asus["available"]
    and (
        asus["pending_reboot"]
        or transition_pending
    )
)

transition_status = ""

if transition_pending:
    target = requested_mode or configured_mode or "requested mode"

    transition_status = (
        f"Restart to finish switching to {target}."
    )


if asus["available"]:
    supported_modes = asus["supported_modes"]
elif switcheroo["dual_gpu"]:
    supported_modes = ["Hybrid"]
else:
    supported_modes = []


print(
    json.dumps(
        {
            "api_version": 1,
            "provider": (
                "asus-armoury"
                if asus["available"]
                else (
                    "switcheroo-control"
                    if switcheroo["available"]
                    else "drm"
                )
            ),
            "current_mode": current_mode,
            "configured_mode": configured_mode,
            "requested_mode": requested_mode,
            "transition_pending": transition_pending,
            "transition_status": transition_status,
            "supported_modes": supported_modes,
            "offload_available": offload_available,
            "switcheroo": switcheroo,
            "drm_devices": drm,
            "mode_switching": {
                "integrated": bool(asus["available"]),
                "hybrid": bool(asus["available"]),
                "discrete": bool(asus["available"]),
                "provider": (
                    "asus-armoury"
                    if asus["available"]
                    else None
                ),
                "reboot_required": reboot_required,
            },
            "asus_armoury": asus,
        },
        separators=(",", ":"),
    )
)
